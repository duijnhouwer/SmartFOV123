{
  "schema_version": 6,
  "protocol_name": "example",
  "subject_number_digit_count": 3,
  "instructions": "You will be looking for three-digit numbers hiding in a <GRIDSIZE> grid.\n\nThe target number will be displayed at the top of the grid.\n\nFirst, read the target number aloud to reveal the digits. Then search for the target.\n\nOnce you find it, read the three-digit number that crosses its middle digit.\n\nNumbers must be spoken one digit at time.\n\nThe next target appears automatically after a correct response.\n\nFind as many targets as possible before time runs out.",
  "debriefing_title": "Time's up!",
  "debriefing": "Your score is <NUMBER_OF_TARGETS_FOUND>. Well done!\n\nPress the Digital Crown to exit",
  "foveated_rendering": true,
  "task_mode": "loop_trials_60_seconds",
  "master_condition_template": {
    "random_seed": "shuffle",
    "digits": {
      "height_degrees": 0.7,
      "font_name": "Courier",
      "rgb": [0, 0, 0],
      "random_method": "flat_distribution"
    },
    "fov": {
      "eye": "right",
      "mode": "optical_see_through_simulation",
      "peak_opacity": 0.35,
      "width_degrees": 14.14,
      "height_degrees": 14.14,
      "horizontal_offset_degrees": 0.0,
      "vertical_offset_degrees": 0.0,
      "distance_meters": 1.5
    },
    "tiles": {
      "width_degrees": 1.2,
      "height_degrees": 1.2,
      "gutter_degrees": 0.2,
      "corner_radius_degrees": 0.3,
      "fill_rgb": [1, 1, 1],
      "gutter_rgb": [0, 0, 0],
      "number_horizontal": 7,
      "number_vertical": 7
    },
    "surround": {
      "fill_rgb": [1.0, 1.0, 1.0],
      "inner_margin_rgb": [0, 0, 0],
      "inner_margin_degrees": 0.3,
      "inner_corner_radius_degrees": 0.5,
      "outer_corner_radius_degrees": 0.5
    },
    "annotation": {
      "height_degrees": 0.6,
      "font_name": "Arial",
      "font_rgb": [0, 0, 0]
    },
    "timer": {
      "bar": {
        "fill_rgb": [1, 1, 1],
        "height_degrees": 0.6,
        "back_rgb": [0, 0, 0],
        "back_height_degrees": 1.0,
        "back_corner_radius": 0.5
      },
      "metronome": {
        "start_seconds": [0, 30, 60, 90, 120, 150, 180, 210, 240, 270],
        "beats_per_minute": [60, 66, 72, 80, 88, 98, 110, 124, 140, 160],
        "volume": 0.0
      },
      "final_gong": true
    },
    "speech": {
      "reset_seconds": 2,
      "aliases": {
        "0": ["zero", "oh", "o"],
        "1": ["one", "won"],
        "2": ["two", "to", "too"],
        "3": ["three", "free", "tree", "dree"],
        "4": ["four", "for", "fore"],
        "5": ["five"],
        "6": ["six", "sicks"],
        "7": ["seven"],
        "8": ["eight", "ate"],
        "9": ["nine"]
      }
    }
  },
  "conditions": [
    {
      "repeats": 2,
      "block_nr": 1,
      "fov": {
        "eye": "right",
        "width_degrees": 14.14,
        "height_degrees": 14.14
      }
    },
    {
      "repeats": 2,
      "block_nr": 1,
      "fov": {
        "eye": "left",
        "width_degrees": 14.14,
        "height_degrees": 14.14
      }
    },
    {
      "repeats": 3,
      "block_nr": 1,
      "fov": {
        "eye": "both",
        "width_degrees": 14.14,
        "height_degrees": 14.14
      }
    },
    {
      "repeats": 2,
      "block_nr": 1,
      "fov": {
        "eye": "right",
        "width_degrees": 21.21,
        "height_degrees": 21.21
      }
    },
    {
      "repeats": 2,
      "block_nr": 1,
      "fov": {
        "eye": "left",
        "width_degrees": 21.21,
        "height_degrees": 21.21
      }
    },
    {
      "repeats": 3,
      "block_nr": 1,
      "fov": {
        "eye": "both",
        "width_degrees": 21.21,
        "height_degrees": 21.21
      }
    }
  ]
